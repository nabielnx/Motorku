APP_NAME=TokoM
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://tokopojok.shop
APP_TIMEZONE=Asia/Jakarta
APP_LOCALE=id
APP_FALLBACK_LOCALE=en
CSP_ENFORCE=true

LOG_CHANNEL=daily
LOG_DAILY_DAYS=14
LOG_LEVEL=warning
APP_MAINTENANCE_DRIVER=file

# Dedicated new production database. Never use the staging database here.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_COOKIE=tokom-session
SESSION_LIFETIME=120
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
QUEUE_CONNECTION=database
CACHE_STORE=database
FILESYSTEM_DISK=local
BROADCAST_CONNECTION=log

MAIL_MAILER=smtp
MAIL_SCHEME=smtps
MAIL_HOST=smtp.gmail.com
MAIL_PORT=465
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=TokoM

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://tokopojok.shop/auth/google/callback
VITE_APP_NAME=TokoM

ORDER_EXPIRY_MINUTES=15
ORDER_PUBLIC_MAX_QUANTITY_PER_ITEM=10
ORDER_PUBLIC_MAX_TOTAL_QUANTITY=30
