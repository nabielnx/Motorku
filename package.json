        "test": "node --test tests/js/*.test.js",
        "skeletons": "node scripts/build-loading-skeletons.mjs"
    },
    "devDependencies": {
        "@tailwindcss/forms": "^0.5.3",
        "@vitejs/plugin-react": "^4.2.0",
        "autoprefixer": "^10.4.12",
        "concurrently": "^9.0.1",
        "laravel-vite-plugin": "^2.0.0",
        "postcss": "^8.4.31",
        "tailwindcss": "^3.2.1",
        "vite": "^7.3.7"
    },
    "dependencies": {
        "@headlessui/react": "^2.0.0",
        "@inertiajs/react": "^2.0.0",
        "axios": "^1.11.0",
        "clsx": "^2.1.1",
        "jsqr": "^1.4.0",
        "qrcode": "^1.5.4",
        "react": "^18.2.0",
        "react-dom": "^18.2.0",
        "react-icons": "^5.7.0",
        "sonner": "^2.0.7",
        "zod": "^4.6.6"
    },
    "overrides": {
