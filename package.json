{
    "$schema": "https://www.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "node -e \"try{require('fs').unlinkSync('public/hot')}catch(e){}\" && vite build && node -e \"try{require('fs').unlinkSync('public/hot')}catch(e){}\" && node scripts/build-loading-skeletons.mjs && node scripts/check-storefront-assets.mjs",
